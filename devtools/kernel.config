# Kernel config fragment for the Velocitor QEMU guest.
# Merged on top of x86_64 defconfig via scripts/kconfig/merge_config.sh.
#
# Adapted from sysprog21/lkmpg, devtools/kernel.config -- see README.md.
# The lkmpg example-specific options (input, uinput, dummy netdev, brd) are
# dropped; PCI, CMA, IOMMU and remoteproc are added.
#
# Changing this file makes setup.sh rebuild the kernel (config hash stamp),
# which costs about fifteen minutes.  Options for later steps of spec
# section 13 are therefore enabled now rather than one rebuild at a time.

# --- Modules ---
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODULE_FORCE_UNLOAD=y

# --- Initramfs boot ---
CONFIG_BLK_DEV_INITRD=y

# --- PCI Express and MSI-X (spec section 3) ---
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_PCIEPORTBUS=y
CONFIG_PCIEAER=y

# --- CMA (spec section 2, step 0 prerequisite) ---
# VEL_HOST_POOL_SIZE is 64 MiB; dma_alloc_coherent() cannot serve that
# without CMA.  boot.sh passes cma= on the command line.
CONFIG_CMA=y
CONFIG_DMA_CMA=y
CONFIG_CMA_AREAS=7

# --- IOMMU (spec sections 9.1 and 14) ---
# Needed to reach the 42-bit DMA trap: without a vIOMMU there is no way to
# hand the device a high IOVA.  Off by default at boot; turn it on with
# KERNEL_CMDLINE_EXTRA="intel_iommu=on".
CONFIG_IOMMU_SUPPORT=y
CONFIG_INTEL_IOMMU=y
CONFIG_INTEL_IOMMU_SVM=y
# CONFIG_INTEL_IOMMU_DEFAULT_ON is not set

# --- remoteproc, rpmsg, virtio (spec sections 6 to 8; steps 6 to 8) ---
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_REMOTEPROC=y
CONFIG_RPMSG=y
CONFIG_RPMSG_VIRTIO=y
CONFIG_RPMSG_NS=y

# --- 9p: share the project root into the guest without rebuilding a rootfs ---
CONFIG_NET=y
CONFIG_INET=y
CONFIG_NETWORK_FILESYSTEMS=y
CONFIG_NET_9P=y
CONFIG_NET_9P_VIRTIO=y
CONFIG_9P_FS=y
CONFIG_9P_FS_POSIX_ACL=y

# --- Filesystems used by the driver's observability (spec section 11) ---
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_DEBUG_FS=y
CONFIG_DEBUG_FS_ALLOW_ALL=y

# --- Tracepoints (spec section 11) ---
# TRACEPOINTS and TRACING come along via FTRACE; asking for them explicitly
# only produces merge_config warnings.
CONFIG_FTRACE=y

# --- Serial console ---
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y

# --- GDB kernel debugging ---
CONFIG_DEBUG_INFO=y
CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=y
CONFIG_DEBUG_KERNEL=y
CONFIG_GDB_SCRIPTS=y
CONFIG_KALLSYMS=y
CONFIG_KALLSYMS_ALL=y

# Disable KASLR so GDB addresses are stable
# CONFIG_RANDOMIZE_BASE is not set

# --- DMA misuse checking ---
# Worth turning on while writing the DMA paths of steps 5 and 8; costs memory
# and noise, so it stays off until wanted.  Add the DMA_API_DEBUG symbol here
# to enable it -- written out rather than shown commented, because
# merge_config.sh reads a commented "# CONFIG_X=y" line as a request and then
# warns that it did not apply.

# --- Trim subsystems the guest never uses, for build and boot time ---
# Expect merge_config.sh to print several hundred "Value requested for
# CONFIG_x not in final .config" lines here.  They are the cascade of the
# five symbols below: disabling a menu makes every symbol under it vanish,
# and merge_config reports each one.  Nothing is wrong; the warnings worth
# reading are the ones naming a symbol that appears in *this* file.
# CONFIG_SOUND is not set
# CONFIG_USB is not set
# CONFIG_WIRELESS is not set
# CONFIG_WLAN is not set
# CONFIG_BLUETOOTH is not set
# CONFIG_NFS_FS is not set
# CONFIG_CIFS is not set
