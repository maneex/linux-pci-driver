# Build environment: kernel source and build, busybox, initramfs, QEMU tree.
# Everything here is reproducible from devtools/ and weighs several GiB.
devtools/.cache/
devtools/config.local

# VM images
vm/*.iso
vm/*.img
vm/*.qcow2

# Editor backups
*~
*.orig
*.rej
*#*

# Build file.s
*.cmd
*.ko
module/velocitor.mod.c
module/modules.order
module/Module.symvers
# Generated firmware image and its generator
firmware/velocitor-fw.elf
firmware/mkfw

# runtime/ is a deliverable (spec 10.3), not a build directory. Said out loud
# because a global ignore file may well carry a bare "runtime" pattern, and a
# parent directory that is excluded takes everything under it with it -- the
# library would simply never be committed, without a word.
!runtime/

# Runtime build artefacts
runtime/src/*.o
runtime/src/*.lo
runtime/*.a
runtime/*.so
runtime/scan-test
runtime/ctrl-test
